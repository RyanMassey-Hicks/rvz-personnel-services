# Prevents Apache from showing a raw file listing if someone requests a
# folder with no index.php in it (e.g. /assets/). Standard shared-hosting
# hardening, and "Options -Indexes" is supported on both Apache 2.2 and
# 2.4 with no special syntax needed.

Options -Indexes

# Canonicalize every request to match SITE_URL in config/config.php.
# Without this, a visitor landing on a non-canonical host/scheme gets
# pages whose AJAX calls (chatbot, live notifications, etc.) target a
# different origin via base_url(), which the browser then blocks as
# cross-origin (CORS) since the page itself loaded on a different host.
# Discovered 2026-08-28 on nhestate.co.za's bare domain — it silently
# broke both the chatbot and the notification poll for anyone who ever
# lands on the site without "www.", which is extremely common (typed
# URLs, old links, etc.).
#
# This same repo is deployed to two hosts during the move from
# nhestate.co.za to recruitement.rvzgroup.co.za (see README), each with
# its own canonical form (old = www required, new = bare required), so
# both rules live here side by side. Delete the nhestate.co.za block
# once the move is fully complete and that host is retired.
RewriteEngine On

# --- nhestate.co.za (being retired — see README) ---
RewriteCond %{HTTP_HOST} ^nhestate\.co\.za$ [NC]
RewriteRule ^ https://www.nhestate.co.za%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^(www\.)?nhestate\.co\.za$ [NC]
RewriteRule ^ https://www.nhestate.co.za%{REQUEST_URI} [L,R=301]

# --- recruitement.rvzgroup.co.za (current) ---
RewriteCond %{HTTP_HOST} ^www\.recruitement\.rvzgroup\.co\.za$ [NC]
RewriteRule ^ https://recruitement.rvzgroup.co.za%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^(www\.)?recruitement\.rvzgroup\.co\.za$ [NC]
RewriteRule ^ https://recruitement.rvzgroup.co.za%{REQUEST_URI} [L,R=301]

# Note: error display is intentionally controlled in config/config.php via
# DEBUG_MODE (ini_set), not here. A raw php_flag directive at the site
# root would break every single page with a 500 error on hosts that run
# PHP via PHP-FPM/suPHP instead of mod_php (see uploads/.htaccess for the
# same issue in more detail) — not a risk worth taking at the root level
# just to add a second layer of the same protection config.php already
# handles correctly.
