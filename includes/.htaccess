# These files are only meant to be require()'d by other PHP scripts, never
# requested directly in a browser.
#
# Written to work on both Apache 2.4 and older Apache 2.2 servers (see
# config/.htaccess for why both blocks are needed).

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
