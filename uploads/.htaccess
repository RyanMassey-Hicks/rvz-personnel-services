# Uploaded files (resumes, company logos) must NEVER be executable as scripts,
# even if someone manages to upload a disguised .php file. This is essential
# on shared hosting where the uploads folder is web-accessible.
#
# Written to work on both Apache 2.4 and older Apache 2.2 servers.

<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|php\d|phtml|pl|py|cgi|sh)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|php\d|phtml|pl|py|cgi|sh)$">
        Order deny,allow
        Deny from all
    </FilesMatch>
</IfModule>

Options -ExecCGI

# php_flag only works when PHP runs as an Apache module (mod_php). Many
# hosts, including this one (a cPanel account on Host Africa/host-h.net,
# which typically runs PHP via PHP-FPM, not mod_php), treat php_flag in a
# .htaccess file as an
# UNKNOWN DIRECTIVE and Apache returns a 500 Internal Server Error for any
# request under this folder. Guarding it in <IfModule mod_php...> makes it
# apply only where it's actually valid, and do nothing (safely) elsewhere.
# The <FilesMatch> block above already blocks .php execution regardless of
# which PHP mode the host uses, so this is a harmless bonus layer, not the
# only protection.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
