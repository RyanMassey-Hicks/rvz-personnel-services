# config.php holds your database password and OAuth secrets. Apache would
# normally execute (not leak) a .php file if requested directly, but this
# blocks that request entirely as a defense-in-depth measure, and also
# blocks the .sample file and this .htaccess itself from being fetched.
#
# Written to work on both Apache 2.4 (mod_authz_core, most current hosting
# including this cPanel/host-h.net account) and older Apache 2.2 servers,
# since the "Require" syntax below is 2.4-only and throws a 500 error on
# 2.2 if used alone.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
